// src/app/ki/tirex_charts/page.tsx
"use client";

import { useEffect, useState } from "react";
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  Tooltip,
  CartesianGrid,
  ReferenceLine,
  ResponsiveContainer,
} from "recharts";

type TiRexChartsResponse = {
  reference_ts: string;
  start_ts: string;
  end_ts: string;
  resolution_minutes: number;
  axis: string[];
  load_actual: (number | null)[];
  load_q50: (number | null)[];
  load_q10: (number | null)[];
  load_q90: (number | null)[];
  price_ct_per_kwh: (number | null)[];
  weather_temp_c: (number | null)[];
  weather_ghi_w_m2: (number | null)[];
  now_index: number;
};

const DEFAULT_SERIES = "meter1:load_kw";
const DEFAULT_HISTORY_HOURS = 48;
const DEFAULT_HORIZON_HOURS = 48;
const DEFAULT_RESOLUTION_MINUTES = 60;

export const dynamic = "force-dynamic";

export default function TiRexChartsPage() {
  const [data, setData] = useState<TiRexChartsResponse | null>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    // Demo und Live-Betrieb immer rund um "jetzt" aufbauen
    const nowIso = new Date().toISOString();

    const params = new URLSearchParams({
      series: DEFAULT_SERIES,
      history_hours: String(DEFAULT_HISTORY_HOURS),
      horizon_hours: String(DEFAULT_HORIZON_HOURS),
      resolution_minutes: String(DEFAULT_RESOLUTION_MINUTES),
      reference_ts: nowIso,
    });

    fetch(`/api/tirex_charts?${params.toString()}`)
      .then(async (res) => {
        if (!res.ok) {
          const text = await res.text();
          throw new Error(`${res.status} – ${text}`);
        }
        return res.json();
      })
      .then((json: TiRexChartsResponse) => {
        console.log("TiRexChartsResponse", json);
        setData(json);
        setError(null);
      })
      .catch((err) => {
        console.error("TiRexChartsPage error:", err);
        setError(err.message ?? String(err));
      });
  }, []);

  const formatTs = (ts: string) =>
    new Date(ts).toLocaleString("de-AT", {
      hour: "2-digit",
      minute: "2-digit",
      day: "2-digit",
      month: "2-digit",
    });

  if (error) {
    return (
      <div className="space-y-4">
        <h1 className="text-xl font-semibold">TiRex Charts</h1>
        <div className="rounded-lg border border-red-500/40 bg-red-950/20 p-3 text-sm text-red-200">
          Fehler beim Laden der TiRex-Charts: {error}
        </div>
      </div>
    );
  }

  if (!data) {
    return (
      <div className="space-y-4">
        <h1 className="text-xl font-semibold">TiRex Charts</h1>
        <div className="rounded-lg border border-slate-800 bg-slate-900/40 p-3 text-sm text-slate-300">
          Lade TiRex-Daten …
        </div>
      </div>
    );
  }

  // -------- Ableitungen aus data (ohne weitere Hooks) -----------------

  const axis = data.axis ?? [];
  const now_index = data.now_index ?? -1;
  const nowTs = now_index >= 0 && now_index < axis.length ? axis[now_index] : null;

  // Oberes Chart: Last (Ist + Forecast), direkt über axis
  const loadChartData = axis.map((ts, i) => ({
    ts,
    actual: data.load_actual[i],
    q50: data.load_q50[i],
    q10: data.load_q10[i],
    q90: data.load_q90[i],
  }));

  // Unten: Preis (Awattar), ebenfalls über dieselbe axis
  const priceChartData = axis.map((ts, i) => ({
    ts,
    price: data.price_ct_per_kwh[i],
  }));

  // Gibt es überhaupt Lastdaten in diesem Fenster?
  const hasLoadData = loadChartData.some(
    (p) =>
      p.actual != null || p.q50 != null || p.q10 != null || p.q90 != null
  );

  // Gibt es überhaupt Preisdaten?
  const hasPriceData = priceChartData.some((p) => p.price != null);

  return (
    <div className="space-y-6">
      {/* Kopfzeile / Info-Bar */}
      <div className="flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h1 className="text-xl font-semibold">
            TiRex Charts – {DEFAULT_SERIES}
          </h1>
          <p className="text-sm text-slate-400">
            Live-orientierte Sicht rund um den aktuellen Zeitpunkt:
            Last-History &amp; Forecast plus Strompreis (Awattar) auf
            gemeinsamer Zeitachse.
          </p>
        </div>
        <div className="text-xs text-right text-slate-400 space-y-1">
          <div>
            Range: {formatTs(data.start_ts)} – {formatTs(data.end_ts)} (
            {data.resolution_minutes} min Raster)
          </div>
          <div>
            Backend-Referenz:{" "}
            <span className="font-mono text-amber-200">
              {formatTs(data.reference_ts)}
            </span>
          </div>
          {nowTs && (
            <div>
              Jetzt-Linie (Axis):{" "}
              <span className="font-mono text-amber-200">
                {formatTs(nowTs)}
              </span>
            </div>
          )}
        </div>
      </div>

      {/* Hinweise zu fehlenden Daten */}
      {!hasLoadData && (
        <div className="rounded-lg border border-amber-500/40 bg-amber-950/20 p-3 text-xs text-amber-200">
          Für den aktuellen Zeitraum liegen noch keine Lastdaten (Ist/Forecast)
          vor. Sobald Messwerte und Forecasts für „jetzt“ verfügbar sind,
          erscheinen sie automatisch im oberen Diagramm.
        </div>
      )}
      {!hasPriceData && (
        <div className="rounded-lg border border-amber-500/40 bg-amber-950/20 p-3 text-xs text-amber-200">
          Für den aktuellen Zeitraum liegen noch keine Strompreis-Daten vor.
          Bitte prüfen, ob der Awattar-Preisloader für heute bereits gelaufen ist.
        </div>
      )}

      {/* 1) Oberes Chart – Last (Ist + Forecast) */}
      <div className="rounded-xl border border-slate-800 bg-slate-950/40 p-3">
        <h2 className="mb-2 text-sm font-semibold text-slate-200">
          Last (Ist + Forecast)
        </h2>
        <div className="h-64">
          <ResponsiveContainer width="100%" height="100%">
            <LineChart data={loadChartData} syncId="tirex-sync">
              <CartesianGrid strokeDasharray="3 3" />
              <XAxis
                dataKey="ts"
                tickFormatter={formatTs}
                minTickGap={32}
                tick={{ fontSize: 10 }}
              />
              <YAxis
                tick={{ fontSize: 10 }}
                label={{
                  value: "kW",
                  angle: -90,
                  position: "insideLeft",
                  style: { fontSize: 10, fill: "#cbd5f5" },
                }}
              />
              <Tooltip labelFormatter={(label) => formatTs(label as string)} />
              {nowTs && (
                <ReferenceLine
                  x={nowTs}
                  stroke="#fbbf24"
                  strokeDasharray="4 4"
                  label={{
                    value: "Jetzt",
                    position: "top",
                    fill: "#fbbf24",
                    fontSize: 10,
                  }}
                />
              )}

              {/* Reihenfolge im Tooltip: q90 (oben), q50, q10, actual */}
              {hasLoadData && (
                <>
                  <Line
                    type="monotone"
                    dataKey="q90"
                    name="Forecast q90"
                    dot={false}
                  />
                  <Line
                    type="monotone"
                    dataKey="q50"
                    name="Forecast q50"
                    dot={false}
                  />
                  <Line
                    type="monotone"
                    dataKey="q10"
                    name="Forecast q10"
                    dot={false}
                  />
                  <Line
                    type="monotone"
                    dataKey="actual"
                    name="Ist"
                    dot={false}
                  />
                </>
              )}
            </LineChart>
          </ResponsiveContainer>
        </div>
      </div>

      {/* 2) Unteres Chart – Strompreis */}
      <div className="rounded-xl border border-slate-800 bg-slate-950/40 p-3">
        <h2 className="mb-2 text-sm font-semibold text-slate-200">
          Strompreis (Awattar)
        </h2>
        <div className="h-56">
          <ResponsiveContainer width="100%" height="100%">
            <LineChart data={priceChartData} syncId="tirex-sync">
              <CartesianGrid strokeDasharray="3 3" />
              <XAxis
                dataKey="ts"
                tickFormatter={formatTs}
                minTickGap={32}
                tick={{ fontSize: 10 }}
              />
              <YAxis
                tick={{ fontSize: 10 }}
                label={{
                  value: "ct/kWh",
                  angle: -90,
                  position: "insideLeft",
                  style: { fontSize: 10, fill: "#cbd5f5" },
                }}
              />
              <Tooltip labelFormatter={(label) => formatTs(label as string)} />
              {nowTs && (
                <ReferenceLine
                  x={nowTs}
                  stroke="#fbbf24"
                  strokeDasharray="4 4"
                  label={{
                    value: "Jetzt",
                    position: "top",
                    fill: "#fbbf24",
                    fontSize: 10,
                  }}
                />
              )}
              {hasPriceData && (
                <Line
                  type="monotone"
                  dataKey="price"
                  name="Preis"
                  dot={false}
                />
              )}
            </LineChart>
          </ResponsiveContainer>
        </div>
      </div>
    </div>
  );
}

