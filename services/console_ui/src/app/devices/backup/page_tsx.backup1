// app/devices/page.tsx
import { getDevices, type Device } from "@/lib/api";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import Link from "next/link";

export const dynamic = "force-dynamic";

export default async function DevicesPage() {
  const devices = await getDevices();

  return (
    <div className="space-y-4">
      <div className="flex items-baseline justify-between gap-3">
        <div>
          <h1 className="text-xl font-semibold">Devices</h1>
          <p className="text-sm text-slate-400">
            Übersicht aller angebundenen Geräte inkl. letztem Event.
          </p>
        </div>
        <span className="text-xs text-slate-400">
          {devices.length} Device(s)
        </span>
      </div>

      <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {devices.map((d: any) => {
          const deviceKey = d.device_id ?? d.id; // je nach deinem Modell

          return (
            <Card key={deviceKey}>
              <CardContent className="p-4 space-y-2">
                <div className="flex items-center justify-between">
                  <div>
                    <div className="text-sm font-semibold">
                      {d.name ?? deviceKey}
                    </div>
                    <div className="text-xs text-slate-400">
                      type: {d.type ?? "n/a"}
                    </div>
                  </div>
                  {/* Link zur Event-Console mit Filter auf dieses Device */}
                  <Link
                    href={`/events?device_id=${encodeURIComponent(
                      deviceKey
                    )}&mode=history`}
                    className="text-xs px-2 py-1 rounded bg-slate-900 border border-slate-700 hover:bg-slate-800"
                  >
                    Events
                  </Link>
                </div>

                <div className="text-xs text-slate-500">
                  {d.location ? d.location : "no location"}
                </div>

                {/* Optional: letzter Event-Text falls vorhanden */}
                {d.latest_event && (
                  <div className="mt-2 text-xs text-slate-400 line-clamp-2">
                    Last event: {d.latest_event}
                  </div>
                )}
              </CardContent>
            </Card>
          );
        })}
      </div>
    </div>
  );
}
