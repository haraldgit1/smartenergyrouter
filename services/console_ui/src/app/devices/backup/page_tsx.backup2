// src/app/devices/page.tsx
import { getDevices, CONSOLE_API_BASE_URL } from "@/lib/api";
import { Card, CardContent } from "@/components/ui/card";
import Link from "next/link";
import { Printer, ChevronDown } from "lucide-react";

export const dynamic = "force-dynamic";

type ListExportProps = {
  entity: string;         // "devices"
  currentSearch?: string; // optional: Suchfilter, z.B. aus URL
};

type Device = {
  id?: string;
  device_id?: string;
  name?: string;
  type?: string;
  location?: string | null;
  latest_event?: string | null;
};

export default async function DevicesPage() {
  const devices: Device[] = await getDevices();

  return (
    <div className="space-y-4">
      {/* Header */}
      <div className="flex items-baseline justify-between gap-3">
        <div>
          <h1 className="text-xl font-semibold">Devices</h1>
          <p className="text-sm text-slate-400">
            Übersicht aller angebundenen Geräte inkl. letztem Event.
          </p>
        </div>
        <span className="text-xs text-slate-400">
          {devices.length} Device(s)
        </span>
      </div>

      {/* Cards */}
      <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
        {devices.map((d, index) => {
          const deviceKey = d.device_id ?? d.id ?? `device-${index}`;
          const deviceName = d.name ?? deviceKey;

          return (
            <Card
              key={deviceKey}
              className="bg-slate-950 border border-slate-800 hover:bg-slate-900 transition-colors"
            >
              <CardContent className="p-4 space-y-3">
                {/* Kopfzeile: Name + Events-Button */}
                <div className="flex items-start justify-between gap-3">
                  <div>
                    <div className="text-sm font-semibold text-slate-50">
                      {deviceName}
                    </div>
                    <div className="text-xs text-slate-400">
                      type: {d.type ?? "n/a"}
                    </div>
                  </div>

                  <Link
                    href={`/events?device_id=${encodeURIComponent(
                      deviceKey
                    )}&mode=history`}
                    className="text-xs px-2 py-1 rounded bg-slate-900 border border-slate-600 text-slate-100 hover:bg-slate-800 hover:border-slate-400"
                  >
                    Events
                  </Link>
                </div>

                {/* Location */}
                <div className="text-xs text-slate-500">
                  {d.location ? (
                    <>Location: {d.location}</>
                  ) : (
                    <>no location</>
                  )}
                </div>

                {/* Letztes Event, wenn vorhanden */}
                {d.latest_event && (
                  <div className="text-xs text-slate-400 line-clamp-2">
                    Last event: {d.latest_event}
                  </div>
                )}
              </CardContent>
            </Card>
          );
        })}
      </div>
    </div>
  );
}


function ListExportButton({ entity, currentSearch }: ListExportProps) {
  const searchParams = new URLSearchParams();
  if (currentSearch) searchParams.set("q", currentSearch);

  const query = searchParams.toString();
  const base = `${process.env.NEXT_PUBLIC_API_BASE_URL}/mdm/reports/${entity}`;

  const openExport = (suffix: string) => {
    const url = `${base}/${suffix}${query ? "?" + query : ""}`;
    window.open(url, "_blank");
  };

  return (
    <div className="relative">
      <button
        type="button"
        className="inline-flex items-center gap-1 px-2 py-1 text-xs border border-slate-700 rounded-md hover:bg-slate-800"
        onClick={() => openExport("list.pdf")}
        title="Liste als PDF drucken"
      >
        <Printer className="h-3 w-3" />
        <span>Report</span>
      </button>
      {/* Wenn du ein Dropdown willst:
      <div className="absolute right-0 mt-1 w-32 rounded-md bg-slate-900 border border-slate-700 shadow-lg">
        <button onClick={() => openExport("list.pdf")} className="w-full text-left px-2 py-1 text-xs hover:bg-slate-800">
          PDF (Liste)
        </button>
        <button onClick={() => openExport("list.csv")} className="w-full text-left px-2 py-1 text-xs hover:bg-slate-800">
          CSV (Excel)
        </button>
      </div>
      */}
    </div>
  );
}
