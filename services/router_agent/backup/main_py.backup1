from fastapi import FastAPI
import os, json, threading
import pika

AMQP_URL = os.getenv("AMQP_URL","amqp://admin:admin@rabbitmq:5672")
app = FastAPI(title="router_agent")
stop_flag=False

def _amqp():
    import pika
    params = pika.URLParameters(AMQP_URL)
    conn = pika.BlockingConnection(params)
    ch = conn.channel()
    ch.exchange_declare(exchange="amq.topic", exchange_type="topic", durable=True)
    q = ch.queue_declare(queue="", exclusive=True).method.queue
    ch.queue_bind(queue=q, exchange="amq.topic", routing_key="decisions.out")
    return conn, ch, q

def worker():
    conn, ch, q = _amqp()
    for method, props, body in ch.consume(q, inactivity_timeout=2):
        if stop_flag: break
        if body is None: continue
        msg = json.loads(body.decode("utf-8"))
        print("[router] would apply setpoint:", msg, flush=True)
        ch.basic_ack(method.delivery_tag)
    try: conn.close()
    except: pass

@app.on_event("startup")
def on_start():
    import threading
    global stop_flag
    stop_flag=False
    threading.Thread(target=worker, daemon=True).start()

@app.on_event("shutdown")
def on_stop():
    global stop_flag; stop_flag=True

@app.get("/health")
def health(): return {"status":"ok","service":"router_agent"}
