from fastapi import FastAPI
import os, json, threading
import pika, psycopg
from datetime import datetime, timezone, timedelta

AMQP_URL = os.getenv("AMQP_URL", "amqp://admin:admin@rabbitmq:5672")
PG_CONN = os.getenv("PG_CONN", "postgres://postgres:postgres@timescaledb:5432/energy")

app = FastAPI(title="predictor_tirex")
stop_flag = False

def _pg(): return psycopg.connect(PG_CONN, autocommit=True)

def _amqp():
    params = pika.URLParameters(AMQP_URL)
    conn = pika.BlockingConnection(params)
    ch = conn.channel()
    ch.exchange_declare(exchange="amq.topic", exchange_type="topic", durable=True)
    q = ch.queue_declare(queue="", exclusive=True).method.queue
    ch.queue_bind(queue=q, exchange="amq.topic", routing_key="features.out")
    return conn, ch, q

def worker():
    conn, ch, q = _amqp()
    with _pg() as pg:
        cur = pg.cursor()
        for method, props, body in ch.consume(q, inactivity_timeout=2):
            if stop_flag: break
            if body is None: continue
            feat = json.loads(body.decode("utf-8"))
            ts0 = datetime.now(timezone.utc).replace(microsecond=0)
            target = ts0 + timedelta(minutes=5)
            v = float((feat.get("feats") or {}).get("v") or 0.0)
            q50 = v; q10 = max(0.0, q50*0.9); q90 = q50*1.1
            cur.execute("""
                INSERT INTO forecasts(ts,target_ts,series,q10,q50,q90,meta)
                VALUES (%s,%s,%s,%s,%s,%s,%s)
                ON CONFLICT DO NOTHING
            """, (ts0.isoformat(), target.isoformat(), feat["series"],
                  q10, q50, q90, json.dumps({"stub": True})))
            ch.basic_publish(exchange="amq.topic", routing_key="forecasts.out",
                             body=json.dumps({"ts": ts0.isoformat(), "target_ts": target.isoformat(),
                                              "series": feat["series"], "q50": q50}).encode("utf-8"))
            ch.basic_ack(method.delivery_tag)
    try: conn.close()
    except: pass

@app.on_event("startup")
def on_start():
    global stop_flag
    stop_flag = False
    threading.Thread(target=worker, daemon=True).start()

@app.on_event("shutdown")
def on_stop():
    global stop_flag
    stop_flag = True

@app.get("/health")
def health(): return {"status":"ok","service":"predictor_tirex"}
