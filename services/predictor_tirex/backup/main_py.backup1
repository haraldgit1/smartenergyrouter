from fastapi import FastAPI
import os, json, threading
import pika, psycopg, torch
from datetime import datetime, timezone, timedelta
from tirex import load_model

AMQP_URL = os.getenv("AMQP_URL", "amqp://admin:admin@rabbitmq:5672")
PG_CONN = os.getenv("PG_CONN", "postgres://postgres:postgres@timescaledb:5432/energy")
HORIZON_HOURS = int(os.getenv("HORIZON_HOURS", "24"))
STEP_MIN = 5
H = int(HORIZON_HOURS*60/STEP_MIN)
WINDOW = 96

app = FastAPI(title="predictor_tirex")
stop_flag = False

def _pg(): return psycopg.connect(PG_CONN, autocommit=True)

def _amqp():
    params = pika.URLParameters(AMQP_URL)
    conn = pika.BlockingConnection(params)
    ch = conn.channel()
    ch.exchange_declare(exchange="amq.topic", exchange_type="topic", durable=True)
    q = ch.queue_declare(queue="", exclusive=True).method.queue
    ch.queue_bind(queue=q, exchange="amq.topic", routing_key="features.out")
    return conn, ch, q

def _load_window(pg, series:str, window:int=WINDOW):
    cur = pg.cursor()
    cur.execute("""
        SELECT ts, (feats->>'v')::float
        FROM features
        WHERE series=%s
        ORDER BY ts DESC
        LIMIT %s
    """, (series, window))
    rows = cur.fetchall()
    rows.reverse()
    vals = [float(v) if v is not None else 0.0 for _, v in rows]
    if len(vals) < window:
        vals = [0.0]*(window-len(vals)) + vals
    return vals

_model = load_model("NX-AI/TiRex")
_device = torch.device("cpu")

def _to_list(x):
    if torch.is_tensor(x): return x.detach().cpu().tolist()
    if isinstance(x, (list, tuple)): return [float(v) for v in x]
    return None

def _forecast(vals, horizon_steps:int):
    context = torch.tensor([vals], dtype=torch.float32, device=_device)  # [1,T]
    q, mean = _model.forecast(context=context, prediction_length=horizon_steps)

    # mean -> [B,H]
    mean_lst = _to_list(mean[0]) if isinstance(mean, torch.Tensor) else _to_list(mean[0])
    if mean_lst is None:
        mean_lst = [0.0]*horizon_steps

    # Versuche verschiedene Quantile-Formate abzufangen:
    q10_lst = q50_lst = q90_lst = None

    # (1) dict-ähnlich: q[0.1]/q[0.5]/q[0.9] jeweils [B,H]
    if isinstance(q, dict):
        def _pick(k):
            t = q.get(k, None)
            if t is None: return None
            return _to_list(t[0]) if torch.is_tensor(t) else _to_list(t[0])
        q10_lst = _pick(0.1)
        q50_lst = _pick(0.5)
        q90_lst = _pick(0.9)

    # (2) Liste/Tuple: [q10, q50, q90] je [B,H]
    if q50_lst is None and isinstance(q, (list, tuple)) and len(q) >= 3:
        cand = [_to_list(q[i][0]) if torch.is_tensor(q[i]) else _to_list(q[i][0]) for i in range(3)]
        if all(c is not None for c in cand):
            q10_lst, q50_lst, q90_lst = cand

    # (3) Tensor mit Quantil-Dimension: [B,H,Q] oder [Q,B,H]
    if q50_lst is None and torch.is_tensor(q):
        dims = q.dim()
        if dims == 3:
            shape = list(q.shape)
            # Versuche [B,H,Q]
            if shape[2] >= 3:
                q10_lst = _to_list(q[0, :, 0])
                q50_lst = _to_list(q[0, :, 1])
                q90_lst = _to_list(q[0, :, 2])
            # Versuche [Q,B,H]
            elif shape[0] >= 3:
                q10_lst = _to_list(q[0, 0, :])
                q50_lst = _to_list(q[1, 0, :])
                q90_lst = _to_list(q[2, 0, :])

    # Fallback: ±10% um mean
    if q50_lst is None:
        q50_lst = mean_lst
        q10_lst = [max(0.0, m*0.9) for m in mean_lst]
        q90_lst = [m*1.1 for m in mean_lst]

    # Länge an horizon_steps anpassen
    def pad_trim(arr):
        arr = (arr or [])
        if len(arr) < horizon_steps: arr = arr + [arr[-1] if arr else 0.0]*(horizon_steps-len(arr))
        return arr[:horizon_steps]

    return pad_trim(q10_lst), pad_trim(q50_lst), pad_trim(q90_lst)

def worker():
    conn, ch, q = _amqp()
    with _pg() as pg:
        cur = pg.cursor()
        for method, props, body in ch.consume(q, inactivity_timeout=2):
            if stop_flag: break
            if body is None: continue
            feat = json.loads(body.decode("utf-8"))
            series = feat.get("series","unknown")
            vals = _load_window(pg, series, WINDOW)
            q10, q50, q90 = _forecast(vals, H)

            ts0 = datetime.now(timezone.utc).replace(microsecond=0)
            for i in range(H):
                target = ts0 + timedelta(minutes=STEP_MIN*(i+1))
                cur.execute("""
                    INSERT INTO forecasts(ts,target_ts,series,q10,q50,q90,meta)
                    VALUES (%s,%s,%s,%s,%s,%s,%s)
                    ON CONFLICT DO NOTHING
                """, (ts0.isoformat(), target.isoformat(), series,
                      float(q10[i]), float(q50[i]), float(q90[i]),
                      json.dumps({"backend":"torch-cpu"})))
                if i == 0:
                    ch.basic_publish(exchange="amq.topic", routing_key="forecasts.out",
                         body=json.dumps({"ts": ts0.isoformat(),"target_ts": target.isoformat(),
                                          "series": series,"q50": float(q50[i]),
                                          "backend":"torch-cpu"}).encode("utf-8"))
            ch.basic_ack(method.delivery_tag)
    try: conn.close()
    except: pass

@app.on_event("startup")
def on_start():
    global stop_flag
    stop_flag = False
    threading.Thread(target=worker, daemon=True).start()

@app.on_event("shutdown")
def on_stop():
    global stop_flag
    stop_flag = True

@app.get("/health")
def health(): return {"status":"ok","service":"predictor_tirex","backend":"torch-cpu"}
