#!/usr/bin/env python3
import json
import os
import time
import uuid
import random
import threading
from dataclasses import dataclass
from typing import Dict, Any, Optional, Tuple

import psycopg2
import psycopg2.extras
import pika

DOMAIN = "battery_pv_price"
ACTIONS = ["IDLE", "CHARGE", "DISCHARGE"]

# ---- Config (Env) ----
PG_CONN_STR = os.environ.get("PG_CONN_STR", "postgres://postgres:postgres@localhost:5432/energy")
RABBIT_URL  = os.environ.get("RABBIT_URL", "amqp://admin:admin@localhost:5672/%2f")

# Exchanges / routing keys (passend zu deinem Stack)
EXCHANGE_IN   = os.environ.get("BANDIT_EXCHANGE_IN",  "amq.default")
#ROUTING_IN    = os.environ.get("BANDIT_ROUTING_IN",   "forecasts.out")
QUEUE_IN  = os.environ.get("BANDIT_QUEUE_IN",  "forecasts.out")

#EXCHANGE_OUT  = os.environ.get("BANDIT_EXCHANGE_OUT", "amq.default")
# Default Exchange für "route to queue by name"
EXCHANGE_OUT = os.environ.get("BANDIT_EXCHANGE_OUT", "")
#ROUTING_OUT   = os.environ.get("BANDIT_ROUTING_OUT",  "decisions.out")
QUEUE_OUT = os.environ.get("BANDIT_QUEUE_OUT", "decisions.out")

EXCHANGE_REW  = os.environ.get("BANDIT_EXCHANGE_REW", "amq.default")
#ROUTING_REW   = os.environ.get("BANDIT_ROUTING_REW",  "rewards.in")
QUEUE_REW = os.environ.get("BANDIT_QUEUE_REW", "rewards.in")

# Bandit params
EPSILON = float(os.environ.get("BANDIT_EPSILON", "0.10"))
ALPHA   = float(os.environ.get("BANDIT_ALPHA",   "0.10"))

# Decision throttling (optional): nur alle X Sekunden eine Entscheidung
MIN_DECISION_INTERVAL_SEC = int(os.environ.get("BANDIT_MIN_DECISION_INTERVAL_SEC", "300"))

@dataclass
class QEntry:
  q: float
  n: int

class BanditStore:
  def __init__(self, pg_conn_str: str):
    self.pg_conn_str = pg_conn_str
    self._conn = psycopg2.connect(pg_conn_str)
    self._conn.autocommit = True

  def close(self):
    try:
      self._conn.close()
    except Exception:
      pass

  def ensure_qvalues(self, domain: str, actions):
    with self._conn.cursor() as cur:
      for a in actions:
        cur.execute(
          """
          INSERT INTO bandit_qvalues(domain, action, q, n)
          VALUES (%s, %s, 0.0, 0)
          ON CONFLICT (domain, action) DO NOTHING
          """,
          (domain, a),
        )

  def load_qvalues(self, domain: str) -> Dict[str, QEntry]:
    with self._conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
      cur.execute("SELECT action, q, n FROM bandit_qvalues WHERE domain=%s", (domain,))
      rows = cur.fetchall()
    qv = {}
    for r in rows:
      qv[r["action"]] = QEntry(float(r["q"]), int(r["n"]))
    return qv

  def upsert_qvalue(self, domain: str, action: str, q: float, n: int):
    with self._conn.cursor() as cur:
      cur.execute(
        """
        INSERT INTO bandit_qvalues(domain, action, q, n, updated_ts)
        VALUES (%s, %s, %s, %s, now())
        ON CONFLICT (domain, action)
        DO UPDATE SET q=EXCLUDED.q, n=EXCLUDED.n, updated_ts=now()
        """,
        (domain, action, q, n),
      )

  def insert_decision(self, decision_id: str, domain: str, policy: str, epsilon: float, action: str, context: Dict[str, Any]):
    with self._conn.cursor() as cur:
      cur.execute(
        """
        INSERT INTO bandit_decisions(decision_id, domain, policy, epsilon, action, context)
        VALUES (%s, %s, %s, %s, %s, %s::jsonb)
        """,
        (decision_id, domain, policy, epsilon, action, json.dumps(context)),
      )

  def insert_reward(self, decision_id: str, domain: str, reward: float, energy_cost_eur: Optional[float], metadata: Optional[Dict[str, Any]]):
    with self._conn.cursor() as cur:
      cur.execute(
        """
        INSERT INTO bandit_rewards(decision_id, domain, reward, energy_cost_eur, metadata)
        VALUES (%s, %s, %s, %s, %s::jsonb)
        ON CONFLICT (decision_id) DO NOTHING
        """,
        (decision_id, domain, reward, energy_cost_eur, json.dumps(metadata or {})),
      )

  def get_decision_action(self, decision_id: str) -> Optional[str]:
    with self._conn.cursor() as cur:
      cur.execute("SELECT action FROM bandit_decisions WHERE decision_id=%s", (decision_id,))
      row = cur.fetchone()
      return row[0] if row else None

class EpsilonGreedyBandit:
  def __init__(self, store: BanditStore, domain: str, actions):
    self.store = store
    self.domain = domain
    self.actions = list(actions)
    self.store.ensure_qvalues(domain, self.actions)
    self.qvalues = self.store.load_qvalues(domain)
    # local cache safety
    for a in self.actions:
      self.qvalues.setdefault(a, QEntry(0.0, 0))

  def choose_action(self) -> Tuple[str, str]:
    # return (action, reason)
    if random.random() < EPSILON:
      a = random.choice(self.actions)
      return a, "explore"
    # exploit: choose max Q (tie-break random)
    max_q = max(self.qvalues[a].q for a in self.actions)
    best = [a for a in self.actions if self.qvalues[a].q == max_q]
    a = random.choice(best)
    return a, "exploit"

  def update(self, action: str, reward: float):
    entry = self.qvalues[action]
    new_q = entry.q + ALPHA * (reward - entry.q)
    new_n = entry.n + 1
    self.qvalues[action] = QEntry(new_q, new_n)
    self.store.upsert_qvalue(self.domain, action, new_q, new_n)

class BanditAgent:
  def __init__(self):
    self.store = BanditStore(PG_CONN_STR)
    self.bandit = EpsilonGreedyBandit(self.store, DOMAIN, ACTIONS)

    self._last_decision_ts = 0.0
    self._latest_context: Optional[Dict[str, Any]] = None

    self._conn = pika.BlockingConnection(pika.URLParameters(RABBIT_URL))
    self._ch = self._conn.channel()

    # ensure queues exist (durable)
    #self._ch.queue_declare(queue=ROUTING_IN, durable=True)
    #self._ch.queue_declare(queue=ROUTING_OUT, durable=True)
    #self._ch.queue_declare(queue=ROUTING_REW, durable=True)
    self._ch.queue_declare(queue=QUEUE_IN, durable=True)
    self._ch.queue_declare(queue=QUEUE_OUT, durable=True)
    self._ch.queue_declare(queue=QUEUE_REW, durable=True)
    self._ch.basic_consume(queue=QUEUE_IN, on_message_callback=self.on_forecast, auto_ack=False)
    self._ch.basic_consume(queue=QUEUE_REW, on_message_callback=self.on_reward, auto_ack=False)

  def close(self):
    try:
      self._conn.close()
    except Exception:
      pass
    self.store.close()

  def _build_context(self, msg: Dict[str, Any]) -> Dict[str, Any]:
    # Minimal context for Battery+PV
    extras = msg.get("extras") or {}
    ts = msg.get("ts")
    series = msg.get("series")

    ctx = {
      "ts": ts,
      "series": series,
      "forecast_load_q50_kw": msg.get("q50"),
      "price_eur_kwh": extras.get("price_eur_kwh"),
      "pv_kw_q50": extras.get("pv_kw_q50"),
      "soc": extras.get("soc"),
      # optional helper features (cheap, explainable)
      "hour_utc": None,
    }

    # derive hour from ISO ts if present
    try:
      if isinstance(ts, str) and "T" in ts:
        ctx["hour_utc"] = int(ts.split("T")[1].split(":")[0])
    except Exception:
      pass

    return ctx

  def _should_decide(self) -> bool:
    now = time.time()
    return (now - self._last_decision_ts) >= MIN_DECISION_INTERVAL_SEC

  def _publish_decision(self, decision: Dict[str, Any]):
    body = json.dumps(decision).encode("utf-8")
    self._ch.basic_publish(
      exchange=EXCHANGE_OUT,      # "" default exchange
      routing_key=QUEUE_OUT,      # queue-name
      body=body,
      properties=pika.BasicProperties(delivery_mode=2, content_type="application/json"),
    )

  def on_forecast(self, ch, method, properties, body: bytes):
    try:
      msg = json.loads(body.decode("utf-8"))
    except Exception:
      ch.basic_ack(delivery_tag=method.delivery_tag)
      return

    # context refresh
    ctx = self._build_context(msg)
    self._latest_context = ctx

    # decide only if throttle allows and required fields exist
    if self._should_decide():
      # minimal guardrails (battery safety stays im Router/Optimizer)
      if ctx.get("price_eur_kwh") is None or ctx.get("forecast_load_q50_kw") is None:
        ch.basic_ack(delivery_tag=method.delivery_tag)
        return

      action, mode = self.bandit.choose_action()
      decision_id = str(uuid.uuid4())

      decision = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "decision_id": decision_id,
        "domain": DOMAIN,
        "action": action,
        "policy": "epsilon_greedy",
        "epsilon": EPSILON,
        "mode": mode,
        "context": ctx,
      }

      # persist + publish
      self.store.insert_decision(decision_id, DOMAIN, "epsilon_greedy", EPSILON, action, ctx)
      self._publish_decision(decision)

      self._last_decision_ts = time.time()

    ch.basic_ack(delivery_tag=method.delivery_tag)

  def on_reward(self, ch, method, properties, body: bytes):
    try:
      msg = json.loads(body.decode("utf-8"))
    except Exception:
      ch.basic_ack(delivery_tag=method.delivery_tag)
      return

    decision_id = msg.get("decision_id")
    domain = msg.get("domain") or DOMAIN
    reward = msg.get("reward")

    # allow computing reward from energy_cost if reward missing
    energy_cost = msg.get("energy_cost_eur")
    if reward is None and energy_cost is not None:
      reward = -float(energy_cost)

    if not decision_id or reward is None:
      ch.basic_ack(delivery_tag=method.delivery_tag)
      return

    action = self.store.get_decision_action(decision_id)
    if action in ACTIONS:
      # persist reward
      self.store.insert_reward(decision_id, domain, float(reward), float(energy_cost) if energy_cost is not None else None, msg.get("metadata") or {})
      # update bandit
      self.bandit.update(action, float(reward))

    ch.basic_ack(delivery_tag=method.delivery_tag)

  def run(self):
    # consumer for forecasts
    self._ch.basic_qos(prefetch_count=25)

    self._ch.basic_consume(queue=ROUTING_IN, on_message_callback=self.on_forecast, auto_ack=False)
    self._ch.basic_consume(queue=ROUTING_REW, on_message_callback=self.on_reward, auto_ack=False)

    print(f"[bandit] domain={DOMAIN} actions={ACTIONS} eps={EPSILON} alpha={ALPHA}")
    print(f"[bandit] consume: {ROUTING_IN}  rewards: {ROUTING_REW}  publish: {ROUTING_OUT}")
    self._ch.start_consuming()

if __name__ == "__main__":
  agent = BanditAgent()
  try:
    agent.run()
  except KeyboardInterrupt:
    pass
  finally:
    agent.close()

